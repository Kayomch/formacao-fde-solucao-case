{
  "contract": "nota_de_devolucao_emitida",
  "version": "1.0.0",
  "description": "A nota de devolução que a emissão da #156 devolve e grava em outbox_return_notes.note_document. Segue o formato das notas do kit (data/kit/notas.json) e acrescenta emitente, nota_referenciada e natureza. Os consumidores leem estas chaves.",
  "consumers": [
    "a rota Emitir e enviar da entrega 3 da #156 (API)",
    "a gaveta da fila de devoluções (web), entrega 3",
    "o anexo da nota enviada, entregas 2 e 5"
  ],
  "kit_source": "data/kit/notas.json",
  "kit_keys_not_carried": ["pedido_referenciado", "canal_entrada"],
  "extra_keys": ["emitente", "nota_referenciada", "natureza"],
  "fields": {
    "nota_id": { "type": "string", "pattern": "^ND-\\d{4,}$" },
    "chave": { "type": "string", "pattern": "^\\d{44}$" },
    "numero": { "type": "integer", "minimum": 1 },
    "serie": { "type": "integer", "minimum": 1 },
    "emitente": { "type": "string", "pattern": "^\\d{14}$" },
    "fornecedor_id": { "type": "string", "pattern": "^F\\d{2,}$" },
    "destino": { "type": "string", "pattern": "^(LJ-\\d{3}|CD-\\d{2})$" },
    "data_emissao": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nota_referenciada": { "type": "string", "pattern": "^\\d{44}$" },
    "natureza": { "type": "string", "enum": ["devolucao"] },
    "itens": { "type": "array", "minItems": 1, "items": "item" },
    "valor_total": { "type": "money" }
  },
  "item": {
    "codigo_fornecedor": { "type": "string", "pattern": "^F\\d{2,}-\\w+$" },
    "sku": { "type": "string", "nullable": true },
    "descricao": { "type": "string", "pattern": "\\S" },
    "quantidade": { "type": "number", "exclusiveMinimum": 0 },
    "unidade": { "type": "string", "enum": ["UN", "CX"] },
    "preco_unitario": { "type": "money" },
    "valor": { "type": "money" }
  },
  "rules": [
    "valor_total é a soma, em centavos, dos valor dos itens",
    "valor de cada item é preco_unitario vezes quantidade, arredondado ao centavo",
    "money é número com no máximo duas casas decimais"
  ]
}
